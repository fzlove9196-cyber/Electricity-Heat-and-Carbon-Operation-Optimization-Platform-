  "上海两部制110kV一般工商业(2025-07: 尖1.2957/峰1.0521/平0.6191/谷0.2943)及时段": "https://energydc.cn/policy/shanghai/2025-07/ee772264-d325-11f0-baa7-46a1f660a16d",
  "DC灵活性25%/3h/15min爬坡": "https://arxiv.org/abs/2507.00909",
