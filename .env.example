# Copy to .env and fill in locally. Do not commit .env.
# Variable names only — no real keys or passwords.

# --- LLM (OpenAI-compatible) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 1 = deterministic Mock mode (no API key required); 0 = call the real endpoint
LLM_MOCK=1

# --- Paths (optional; defaults are ./artifacts and ./data) ---
# ARTIFACT_DIR=./artifacts
# DATA_DIR=./data

# --- Embeddings / RAG ---
# Empty EMBED_* falls back to the LLM endpoint or to local BM25 + bge-m3
EMBED_MODEL=
EMBED_BASE_URL=
EMBED_API_KEY=
# local | openai | none
RAG_EMBED_BACKEND=
LOCAL_EMBED_MODEL=
# 1 = on, 0 = off
RAG_RERANK=
RERANK_MODEL=
# lancedb | sqlite
RAG_VECTOR_STORE=
# RAG_PRELOAD=1

# Hugging Face mirror if huggingface.co is unreachable
# HF_ENDPOINT=https://hf-mirror.com

# --- Carbon intensity adapters (optional; default is a synthetic profile) ---
CARBON_SOURCE=
CARBON_AWARE_URL=
CARBON_LOCATION=
CARBON_FILE=
CARBON_URL=
WATTTIME_USER=
WATTTIME_PASSWORD=

# --- Runtime / scripts ---
# HOST=0.0.0.0
# PORT=8080
# PY=
# SDCO_PYTHON=
# SIM_AGENT_ROOT=
# SDCO_DC_IGNORE_TAP=
